# Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# ── Bybit credentials ────────────────────────────────────────
# IMPORTANT: these must be DEMO TRADING keys, created from a mainnet
# account. Log in at bybit.com → switch to Demo Trading → hover your
# avatar → API → create key.
#
# Testnet keys will NOT work against the demo endpoint, and vice versa.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Demo Trading: real mainnet prices and liquidity, fake money.
# Set both to false only when you intend to trade real funds.
BYBIT_DEMO=true
BYBIT_TESTNET=false

# ── Universe ─────────────────────────────────────────────────
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# ── Futures mechanics ────────────────────────────────────────
# Leverage caps notional; it does NOT set risk. Risk per trade is
# controlled by the stop distance (see RISK_PER_TRADE in config.py).
LEVERAGE=3
